# Copy to .env for local development. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# Supported providers will be configured through a common interface.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# GitHub App/webhook configuration; keep secrets out of source control.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# Publishing must remain disabled until explicitly configured.
ENABLE_GITHUB_PUBLISHING=false
